# Copy to web/.env.local (gitignored) and fill in. Never commit real keys.

# Solana RPC used by the browser (Helius devnet recommended; falls back to api.devnet.solana.com)
VITE_RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_KEY

# Relayer URL as seen by the browser. Default '/relayer' is proxied by Vite to the local relayer.
# VITE_RELAYER_URL=/relayer

# Where Vite forwards /relayer (set in the shell when starting `yarn dev`, not here):
#   RELAYER_TARGET=http://127.0.0.1:8787 yarn dev
